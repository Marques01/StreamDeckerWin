@implements IAsyncDisposable

@code {
    private readonly Random random = new();

    private PeriodicTimer? timer;
    private CancellationTokenSource? cancellationTokenSource;
    private PerformanceCounter? cpuCounter;
    private PerformanceCounter? diskCounter;
    private PerformanceCounterCategory? gpuCategory;
    private readonly Dictionary<string, PerformanceCounter> gpuCounters = new();
    private string mediaArtist = "Nenhuma música";
    private string mediaTitle = "Nenhuma música em reprodução";
    private bool isMediaPlaying;
    private int volumePercent;
    private MMDeviceEnumerator? audioDeviceEnumerator;
    private MMDevice? audioDevice;

#if WINDOWS
    private Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager? mediaManager;
    private Windows.Media.Control.GlobalSystemMediaTransportControlsSession? mediaSession;
#endif

    private int cpuUsage = 0;
    private double CpuDashOffset => 100.53 * (1.0 - Math.Clamp(cpuUsage, 0, 100) / 100.0);

    private const int HistorySize = 24;

    private readonly List<int> cpuHistory = Enumerable.Repeat(35, HistorySize).ToList();

    protected override void OnInitialized()
    {
        cancellationTokenSource = new CancellationTokenSource();

        if (OperatingSystem.IsWindows())
        {
            cpuCounter = new PerformanceCounter(
                "Processor",
                "% Processor Time",
                "_Total");

            cpuCounter.NextValue();

            diskCounter = new PerformanceCounter(
                "PhysicalDisk",
                "% Disk Time",
                "_Total");

            diskCounter.NextValue();

            gpuCategory = new PerformanceCounterCategory("GPU Engine");

            InitializeAudioVolume();
        }

        _ = InitializeMediaAsync();

        timer = new PeriodicTimer(
            TimeSpan.FromMilliseconds(400));

        _ = UpdateCpuAsync(cancellationTokenSource.Token);
    }

    private void UpdateCpu()
    {
        if (cpuCounter is null)
            return;

        int usoCpu = Math.Clamp(
            (int)Math.Round(cpuCounter.NextValue()),
            0,
            100);

        Console.WriteLine($"Uso da CPU: {usoCpu:F1}%");

        cpuUsage = usoCpu;

        cpuHistory.RemoveAt(0);
        cpuHistory.Add(cpuUsage);
    }

    private string GetCpuColor(int value)
    {
        if (value >= 80)
            return "#ef647c";

        if (value >= 60)
            return "#e9b84e";

        return "#2999ff";
    }

    private async Task UpdateCpuAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(cancellationToken))
            {
                UpdateCpu();
                UpdateRam();
                UpdateGpu();
                UpdateDisk();
                await UpdateMediaAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Encerramento normal
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (cancellationTokenSource is not null)
        {
            await cancellationTokenSource.CancelAsync();
            cancellationTokenSource.Dispose();
        }

        cpuCounter?.Dispose();
        diskCounter?.Dispose();
        audioDevice?.Dispose();
        audioDeviceEnumerator?.Dispose();

        foreach (var counter in gpuCounters.Values)
            counter.Dispose();

        timer?.Dispose();
    }

    private void InitializeAudioVolume()
    {
        try
        {
            audioDeviceEnumerator = new MMDeviceEnumerator();
            audioDevice = audioDeviceEnumerator.GetDefaultAudioEndpoint(
                DataFlow.Render,
                Role.Multimedia);

            volumePercent = Math.Clamp(
                (int)Math.Round(
                    audioDevice.AudioEndpointVolume.MasterVolumeLevelScalar * 100),
                0,
                100);
        }
        catch (COMException)
        {
            volumePercent = 0;
        }
    }

    private void HandleVolumeInput(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
            return;

        volumePercent = Math.Clamp(value, 0, 100);

        if (audioDevice is not null)
        {
            audioDevice.AudioEndpointVolume.MasterVolumeLevelScalar =
                volumePercent / 100f;
        }
    }

    private async Task InitializeMediaAsync()
    {
#if WINDOWS
        try
        {
            mediaManager = await Windows.Media.Control
                .GlobalSystemMediaTransportControlsSessionManager
                .RequestAsync();

            await UpdateMediaAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or COMException)
        {
            mediaManager = null;
        }
#else
        await Task.CompletedTask;
#endif
    }

    private async Task UpdateMediaAsync()
    {
#if WINDOWS
        if (mediaManager is null)
            return;

        mediaSession = mediaManager.GetCurrentSession();

        if (mediaSession is null)
        {
            mediaArtist = "Nenhuma música";
            mediaTitle = "Nenhuma música em reprodução";
            isMediaPlaying = false;
            return;
        }

        var properties = await mediaSession.TryGetMediaPropertiesAsync();
        var playbackInfo = mediaSession.GetPlaybackInfo();

        mediaArtist = string.IsNullOrWhiteSpace(properties.Artist)
            ? "Artista desconhecido"
            : properties.Artist;

        mediaTitle = string.IsNullOrWhiteSpace(properties.Title)
            ? "Faixa desconhecida"
            : properties.Title;

        isMediaPlaying = playbackInfo.PlaybackStatus ==
            Windows.Media.Control
                .GlobalSystemMediaTransportControlsSessionPlaybackStatus.Playing;
#else
        await Task.CompletedTask;
#endif
    }

    private async Task TogglePlaybackAsync()
    {
#if WINDOWS
        if (mediaSession is not null)
            await mediaSession.TryTogglePlayPauseAsync();
#else
        await Task.CompletedTask;
#endif
    }

    private async Task PreviousTrackAsync()
    {
#if WINDOWS
        if (mediaSession is not null)
            await mediaSession.TrySkipPreviousAsync();
#else
        await Task.CompletedTask;
#endif
    }

    private async Task NextTrackAsync()
    {
#if WINDOWS
        if (mediaSession is not null)
            await mediaSession.TrySkipNextAsync();
#else
        await Task.CompletedTask;
#endif
    }

    private int ramUsage = 34;

    private readonly List<int> ramHistory = Enumerable.Repeat(34, 24).ToList();

    private double RamDashOffset => 100.53 * (1.0 - Math.Clamp(ramUsage, 0, 100) / 100.0);

    private string RamHistoryPoints => string.Join(" ", ramHistory.Select((value, index) =>
        {
            var x = index * 100.0 / (ramHistory.Count - 1);
            var y = 27 - (value / 100.0 * 24);

            return $"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }));

    private void UpdateRam()
    {
        if (!OperatingSystem.IsWindows())
            return;

        var memoryStatus = new MemoryStatusEx
        {
            Length = (uint)Marshal.SizeOf<MemoryStatusEx>()
        };

        if (GlobalMemoryStatusEx(ref memoryStatus))
            ramUsage = Math.Clamp((int)memoryStatus.MemoryLoad, 0, 100);

        ramHistory.RemoveAt(0);
        ramHistory.Add(ramUsage);
    }

    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
    private struct MemoryStatusEx
    {
        public uint Length;
        public uint MemoryLoad;
        public ulong TotalPhysicalMemory;
        public ulong AvailablePhysicalMemory;
        public ulong TotalPageFile;
        public ulong AvailablePageFile;
        public ulong TotalVirtualMemory;
        public ulong AvailableVirtualMemory;
        public ulong AvailableExtendedVirtualMemory;
    }

    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    private static extern bool GlobalMemoryStatusEx(ref MemoryStatusEx memoryStatus);

    private string CpuHistoryPoints =>
    string.Join(" ", cpuHistory.Select((value, index) =>
    {
        var x = index * 100.0 / (cpuHistory.Count - 1);
        var y = 27 - (value / 100.0 * 24);

        return $"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
    }));

    private int gpuUsage = 0;

    private readonly List<int> gpuHistory = Enumerable.Repeat(0, HistorySize).ToList();

    private double GpuDashOffset => 100.53 * (1.0 - Math.Clamp(gpuUsage, 0, 100) / 100.0);

    private string GpuHistoryPoints =>
        string.Join(" ", gpuHistory.Select((value, index) =>
        {
            var x = index * 100.0 / (gpuHistory.Count - 1);
            var y = 27 - (value / 100.0 * 24);

            return $"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }));

    private void UpdateGpu()
    {
        if (!OperatingSystem.IsWindows() || gpuCategory is null)
            return;

        try
        {
            var instances = gpuCategory
                .GetInstanceNames()
                .Where(instance => instance.Contains(
                    "engtype_3D",
                    StringComparison.OrdinalIgnoreCase))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            foreach (var instance in instances)
            {
                if (!gpuCounters.ContainsKey(instance))
                {
                    var counter = new PerformanceCounter(
                        "GPU Engine",
                        "% Utilization Percentage",
                        instance);

                    counter.NextValue();
                    gpuCounters[instance] = counter;
                }
            }

            foreach (var instance in gpuCounters.Keys.Except(instances).ToList())
            {
                gpuCounters[instance].Dispose();
                gpuCounters.Remove(instance);
            }

            gpuUsage = Math.Clamp(
                (int)Math.Round(gpuCounters.Values
                    .Select(counter => counter.NextValue())
                    .DefaultIfEmpty()
                    .Max()),
                0,
                100);
        }
        catch (InvalidOperationException)
        {
            gpuUsage = 0;
        }

        gpuHistory.RemoveAt(0);
        gpuHistory.Add(gpuUsage);
    }

    private int diskUsage;

    private double DiskDashOffset => 100.53 * (1.0 - Math.Clamp(diskUsage, 0, 100) / 100.0);

    private void UpdateDisk()
    {
        if (!OperatingSystem.IsWindows() || diskCounter is null)
            return;

        diskUsage = Math.Clamp((int)Math.Round(diskCounter.NextValue()), 0, 100);
    }
}
